---
import Link from "@/components/ui/link.astro";
import { Icon } from "astro-icon/components";
---

<main
  class="grid place-items-center pt-16 pb-8 md:pt-20 md:pb-24 relative">
  <!-- Background gradient -->
  <div class="absolute inset-0 -z-10 bg-gradient-to-br from-slate-50 via-blue-50/30 to-cyan-50/30"></div>

  <div class="text-center max-w-4xl">
    <h1
      class="text-5xl lg:text-6xl xl:text-7xl font-bold lg:tracking-tight xl:tracking-tighter bg-gradient-to-r from-slate-900 via-blue-900 to-cyan-900 bg-clip-text text-transparent">
      Software excellence that transforms your business
    </h1>
    <p class="text-lg mt-6 text-slate-700 max-w-3xl mx-auto leading-relaxed">
      ARACON SOFTWARE delivers expert software development and IT advisory services.
      We don't just write code—we elevate teams, improve practices, and create
      lasting value beyond the deliverables.
    </p>
    <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
      <a
        href="#contact"
        class="inline-flex gap-2 items-center justify-center px-6 py-3 bg-gradient-to-r from-blue-600 to-cyan-600 text-white rounded-lg hover:from-blue-700 hover:to-cyan-700 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 font-medium">
        <Icon class="text-white w-5 h-5" name="bx:bxs-envelope" />
        Request a Consultation
      </a>
      <a
        href="#services"
        class="inline-flex gap-2 items-center justify-center px-6 py-3 bg-white text-slate-700 rounded-lg hover:bg-slate-50 transition-all border-2 border-slate-200 hover:border-blue-300 shadow-md hover:shadow-lg font-medium">
        <Icon class="text-blue-600 w-5 h-5" name="bx:bxs-briefcase" />
        Our Services
      </a>
    </div>
  </div>
</main>
