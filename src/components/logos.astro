---
import { Icon } from "astro-icon/components";
import { Picture } from "astro:assets";
import profileImage from "@/assets/linkedin_profile.jpeg";
---

<div id="about" class="py-8 md:py-12 max-w-5xl mx-auto scroll-mt-24">
  <div class="glass-card p-8 md:p-12 shadow-2xl">
  <div class="text-center mb-10">
    <p class="text-[var(--color-text-secondary)] text-xs font-semibold uppercase tracking-[0.2em] mb-3">
      Who we are
    </p>
    <h2 class="text-3xl md:text-4xl font-bold text-[var(--color-text-primary)] tracking-tight">
      Built on 20+ years of shipping.
    </h2>
  </div>
  <div class="flex flex-col md:flex-row gap-8 items-center md:items-start">
    <div class="shrink-0">
      <Picture
        src={profileImage}
        alt="Pere Villega"
        widths={[200, 300]}
        sizes="(max-width: 768px) 200px, 300px"
        class="rounded-full w-32 h-32 md:w-36 md:h-36 object-cover shadow-xl ring-4 ring-[var(--color-border-card)]"
        loading="lazy"
        format="webp"
      />
    </div>
    <div class="flex-1 text-center md:text-left">
      <h3 class="text-[var(--color-text-primary)] font-semibold text-base">
        Pere Villega
      </h3>
      <p class="text-[var(--color-accent-cyan)] text-xs mb-3">
        Founder & Principal Engineer
      </p>
      <p class="text-[var(--color-text-secondary)] text-sm leading-relaxed mb-4">
        Aracon was founded on a simple principle: AI should ship, not sit in
        notebooks. We bring distributed systems expertise and production
        engineering discipline to every engagement.
      </p>
      <div class="flex gap-3 justify-center md:justify-start">
        <a
          href="https://www.linkedin.com/in/perevillega/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-3 py-1.5 border border-[var(--color-border-card)] rounded-md text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:border-[var(--color-accent-cyan)]/30 transition-colors text-xs">
          <Icon class="w-4 h-4" name="bx:bxl-linkedin" />
          LinkedIn
        </a>
        <a
          href="https://perevillega.com"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-3 py-1.5 border border-[var(--color-border-card)] rounded-md text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:border-[var(--color-accent-cyan)]/30 transition-colors text-xs">
          <Icon class="w-4 h-4" name="bx:bxs-user-circle" />
          Personal Site
        </a>
      </div>
    </div>
  </div>
  </div>

</div>
