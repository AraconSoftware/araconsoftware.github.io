  },
  {
    title: "IT Advisory & Consulting",
    description:
      "Strategic technology guidance and architecture design. Making informed decisions about your tech stack, infrastructure, and development practices.",
    icon: "bx:bxs-brain",
  },
  {
    title: "System Architecture",
    description:
      "Design and implementation of scalable, maintainable architectures. Focus on long-term sustainability and team productivity.",
    icon: "bx:bxs-server",
  },
  {
    title: "Technical Leadership",
